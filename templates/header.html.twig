<div class="drawer-side">
    <label for="main-drawer" aria-label="close sidebar" class="drawer-overlay"></label>
    <aside class="bg-base-200 h-screen w-70 flex flex-col">
        <div class="p-4 mb-4">
            <h1 class="text-2xl font-bold px-4">{{ 'meta.title.default'|trans }}</h1>
        </div>

        <div class="flex-1 overflow-y-auto px-4">
            <ul class="menu w-full gap-2">
                <li>
                    <a href="{{ path('app_dashboard') }}" class="flex items-center gap-3">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                        </svg>
                        <span>{{ 'nav.dashboard'|trans }}</span>
                    </a>
                </li>

                {% if is_granted('ROLE_AUTEUR') or is_granted('ROLE_EDITEUR') or is_granted('ROLE_ADMIN') %}
                <li>
                    <a href="{{ path('app_article_index') }}" class="flex items-center gap-3">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                        </svg>
                        <span>{{ 'nav.articles'|trans }}</span>
                    </a>
                </li>
                {% endif %}

                {% if is_granted('ROLE_AUTEUR') or is_granted('ROLE_EDITEUR') or is_granted('ROLE_ADMIN') %}
                <li>
                    <a href="{{ path('app_media_index') }}" class="flex items-center gap-3">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                        </svg>
                        <span>{{ 'nav.images'|trans }}</span>
                    </a>
                </li>
                {% endif %}

                {% if is_granted('ROLE_FOURNISSEUR') or is_granted('ROLE_ADMIN') %}
                <li>
                    <a href="{{ path('app_csv_index') }}" class="flex items-center gap-3">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                        </svg>
                        <span>{{ 'nav.csv_charts'|trans }}</span>
                    </a>
                </li>
                {% endif %}

                {% if is_granted('ROLE_DESIGNEUR') or is_granted('ROLE_ADMIN') %}
                <li>
                    <a href="{{ path('app_theme_index') }}" class="flex items-center gap-3">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
                        </svg>
                        <span>{{ 'nav.theme'|trans }}</span>
                    </a>
                </li>
                {% endif %}

                <div class="divider"></div>

                {% if is_granted('ROLE_ADMIN') %}
                <li>
                    <a href="{{ path('app_user_index') }}" class="flex items-center gap-3">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                        </svg>
                        <span>{{ 'nav.users'|trans }}</span>
                    </a>
                </li>
                {% endif %}
            </ul>
        </div>

        <div class="p-4 border-t border-base-300 flex-shrink-0">
            <div class="mb-3">
                {{ include('components/_language_switcher.html.twig') }}
            </div>

            {% if app.user %}
                <div class="dropdown dropdown-top w-full">
                    <div tabindex="0" role="button" class="btn btn-ghost w-full justify-start gap-3 px-3">
                        <div class="w-10 h-10 rounded-full bg-base-300 flex items-center justify-center overflow-hidden">
                            {% if app.user.avatar %}
                                <img src="{{ asset('uploads/avatars/' ~ app.user.avatar) }}" alt="Avatar" class="w-full h-full object-cover">
                            {% else %}
                                <span class="text-sm font-medium text-base-content/70">{{ app.user.prenom[:1] }}{{ app.user.nom[:1] }}</span>
                            {% endif %}
                        </div>
                        <div class="flex flex-col items-start flex-1 overflow-hidden">
                            <span class="text-xs opacity-60 truncate w-full">{{ app.user.email }}</span>
                        </div>
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" />
                        </svg>
                    </div>
                    <ul tabindex="0" class="dropdown-content z-[1] menu p-2 shadow-lg bg-base-100 rounded-box w-full mb-2 border border-base-300">
                        <li>
                            <a href="{{ path('app_profile') }}" class="flex items-center gap-3">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                </svg>
                                <span>{{ 'nav.profile'|trans }}</span>
                            </a>
                        </li>
                        <div class="divider my-1"></div>
                        <li>
                            <a href="{{ path('app_logout') }}" class="flex items-center gap-3 text-error">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                                </svg>
                                <span>{{ 'nav.logout'|trans }}</span>
                            </a>
                        </li>
                    </ul>
                </div>
            {% else %}
                <a href="{{ path('app_login') }}" class="border border-base-content bg-base-content text-base-100 hover:opacity-90 transition-opacity px-4 py-2 rounded-lg text-sm font-medium flex items-center justify-center gap-2 w-full">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1" />
                    </svg>
                    <span>{{ 'nav.login'|trans }}</span>
                </a>
            {% endif %}
        </div>
    </aside>
</div>
