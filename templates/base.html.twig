<!doctype html>
<html lang="fr" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />
    <title>{% block title %}{{ 'meta.title.default'|trans }}{% endblock %}</title>
    <meta name="description" content="{% block meta_description %}{{ 'meta.description.default'|trans }}{% endblock %}" />
    <meta name="robots" content="{% block meta_robots %}noindex, nofollow{% endblock %}" />
    {% block stylesheets %}
      {{ encore_entry_link_tags('app') }}
    {% endblock %}
    {% block javascripts %}
      {{ encore_entry_script_tags('app') }}
    {% endblock %}
  </head>
  <body>
    <div class="drawer lg:drawer-open" data-controller="chart-manager media-manager">
      <input id="main-drawer" type="checkbox" class="drawer-toggle" />
      <div class="drawer-content flex flex-col">
        {# Mobile navbar #}
        <div class="navbar bg-base-300 lg:hidden">
          <div class="flex-none">
            <label for="main-drawer" class="btn btn-square btn-ghost drawer-button">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="inline-block w-5 h-5 stroke-current">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
              </svg>
            </label>
          </div>
          <div class="flex-1">
            <a class="btn btn-ghost text-xl">{{ 'meta.title.default'|trans }}</a>
          </div>
        </div>
        <main class="flex-1 p-6">
          {% block body %}{% endblock %}
        </main>
      </div>
      {% include 'header.html.twig' %}
    </div>
  </body>
</html>