{% extends 'base.html.twig' %}

{% block title %}Gestion des CSV{% endblock %}

{% block body %}
<div class="drawer-content flex flex-col p-8" data-controller="csv-library">
    <div class="max-w-7xl mx-auto w-full">
        <div class="mb-8">
            <h1 class="text-3xl font-bold">Bibliothèque CSV</h1>
            <p class="text-base-content/70 mt-2">Gérez vos fichiers CSV pour les graphiques</p>
        </div>

        <div id="flash-container" class="mb-4"></div>

        <div class="card bg-base-100 shadow-sm border border-base-300">
            <div class="card-body">
                <div
                    class="border-2 border-dashed border-base-300 rounded-lg p-8 text-center hover:border-primary hover:bg-base-200 transition-colors cursor-pointer"
                    data-csv-library-target="dropzone"
                    data-action="dragover->csv-library#handleDragOver dragleave->csv-library#handleDragLeave drop->csv-library#handleDrop click->csv-library#openFileDialog"
                >
                    <input
                        type="file"
                        accept=".csv,text/csv"
                        multiple
                        class="hidden"
                        data-csv-library-target="fileInput"
                        data-action="change->csv-library#handleFileSelect"
                    >
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 mx-auto mb-4 text-base-content/50" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
                    </svg>
                    <p class="text-lg font-medium mb-2">Glissez-déposez vos fichiers CSV ici</p>
                    <p class="text-sm text-base-content/60">ou cliquez pour sélectionner (max 2MB par fichier)</p>
                </div>

                <div class="mt-4 hidden" data-csv-library-target="uploadProgress">
                    <div class="flex items-center justify-between mb-2">
                        <span class="text-sm font-medium" data-csv-library-target="progressText">Upload en cours...</span>
                        <span class="text-sm text-base-content/60" data-csv-library-target="progressPercent">0%</span>
                    </div>
                    <progress class="progress progress-primary w-full" value="0" max="100" data-csv-library-target="progressBar"></progress>
                </div>
            </div>
        </div>

        <div class="divider my-8">Fichiers CSV</div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4" data-csv-library-target="csvGrid">
        </div>

        <dialog class="modal" data-csv-library-target="deleteModal">
            <div class="modal-box">
                <h3 class="font-bold text-lg">Confirmer la suppression</h3>
                <p class="py-4">Êtes-vous sûr de vouloir supprimer ce fichier CSV ?</p>
                <div class="modal-action">
                    <button class="btn" data-action="click->csv-library#closeDeleteModal">Annuler</button>
                    <button class="btn btn-error" data-action="click->csv-library#confirmDelete">Supprimer</button>
                </div>
            </div>
            <form method="dialog" class="modal-backdrop">
                <button data-action="click->csv-library#closeDeleteModal">close</button>
            </form>
        </dialog>

        <dialog class="modal" data-csv-library-target="previewModal">
            <div class="modal-box max-w-3xl">
                <h3 class="font-bold text-lg mb-4">Aperçu du fichier</h3>
                <div class="bg-base-200 p-4 rounded-lg overflow-x-auto">
                    <pre class="text-xs" data-csv-library-target="previewContent"></pre>
                </div>
                <div class="modal-action">
                    <button class="btn" data-action="click->csv-library#closePreviewModal">Fermer</button>
                </div>
            </div>
            <form method="dialog" class="modal-backdrop">
                <button data-action="click->csv-library#closePreviewModal">close</button>
            </form>
        </dialog>
    </div>
</div>
{% endblock %}
