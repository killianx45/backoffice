{% extends 'base.html.twig' %}

{% block title %}{{ 'dashboard.title'|trans }}{% endblock %}

{% block body %}
<div class="container mx-auto px-6 py-12 max-w-7xl">
    {# Banner de vérification d'email #}
    {% if not app.user.isVerified %}
    <div class="mb-8">
        <div role="alert" class="alert border border-base-300 bg-base-100">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-base-content/60 shrink-0 w-6 h-6">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <div class="flex-1">
                <h3 class="font-medium text-sm text-base-content">{{ 'registration.banner.title'|trans }}</h3>
                <div class="text-xs text-base-content/60 mt-1">
                    {{ 'registration.banner.description'|trans({'%email%': app.user.email}) }}
                </div>
                <div class="text-xs text-base-content/60 mt-2">
                    {{ 'registration.banner.warning'|trans }}
                </div>
            </div>
            <form method="post" action="{{ path('app_resend_verification_email') }}" class="inline">
                <button type="submit" class="btn btn-sm">
                    {{ 'registration.banner.resend_button'|trans }}
                </button>
            </form>
        </div>
    </div>
    {% endif %}

    {# Section de bienvenue #}
    <div class="mb-12">
        <h1 class="text-3xl font-semibold mb-2 text-base-content">{{ 'message.welcome'|trans({'%name%': app.user.prenom}) }}</h1>
        <p class="text-base-content/60 text-sm">{{ 'dashboard.subtitle'|trans }}</p>
    </div>

    {# Section d'explication du CMS #}
    <div class="mb-12 border border-base-300 rounded-lg p-6 bg-base-100">
        <h2 class="text-xl font-medium mb-4 text-base-content">{{ 'dashboard.about.title'|trans }}</h2>
        <p class="text-base-content/70 text-sm mb-6 leading-relaxed">
            {{ 'dashboard.about.description'|trans }}
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="flex items-start gap-3">
                <div class="w-8 h-8 flex items-center justify-center text-base-content/40">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                </div>
                <div>
                    <p class="font-medium text-sm text-base-content">{{ 'dashboard.features.articles.title'|trans }}</p>
                    <p class="text-xs text-base-content/60 mt-1">{{ 'dashboard.features.articles.description'|trans }}</p>
                </div>
            </div>
            <div class="flex items-start gap-3">
                <div class="w-8 h-8 flex items-center justify-center text-base-content/40">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                </div>
                <div>
                    <p class="font-medium text-sm text-base-content">{{ 'dashboard.features.images.title'|trans }}</p>
                    <p class="text-xs text-base-content/60 mt-1">{{ 'dashboard.features.images.description'|trans }}</p>
                </div>
            </div>
            <div class="flex items-start gap-3">
                <div class="w-8 h-8 flex items-center justify-center text-base-content/40">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                </div>
                <div>
                    <p class="font-medium text-sm text-base-content">{{ 'dashboard.features.csv.title'|trans }}</p>
                    <p class="text-xs text-base-content/60 mt-1">{{ 'dashboard.features.csv.description'|trans }}</p>
                </div>
            </div>
            <div class="flex items-start gap-3">
                <div class="w-8 h-8 flex items-center justify-center text-base-content/40">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
                    </svg>
                </div>
                <div>
                    <p class="font-medium text-sm text-base-content">{{ 'dashboard.features.themes.title'|trans }}</p>
                    <p class="text-xs text-base-content/60 mt-1">{{ 'dashboard.features.themes.description'|trans }}</p>
                </div>
            </div>
        </div>
    </div>

    {# Actions rapides #}
    <div class="mb-12">
        <h2 class="text-xl font-medium mb-6 text-base-content">{{ 'dashboard.quick_actions.title'|trans }}</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            {% for action in quick_actions %}
                <a href="{% if action.route == '#' %}#{% else %}{{ path(action.route) }}{% endif %}"
                   class="group border border-base-300 rounded-lg p-5 hover:border-base-content/20 transition-colors bg-base-100">
                    <div class="flex items-start gap-4">
                        <div class="w-10 h-10 flex items-center justify-center text-base-content/40 group-hover:text-base-content/60 transition-colors">
                            {% if action.icon == 'article' %}
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                                </svg>
                            {% elseif action.icon == 'image' %}
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                </svg>
                            {% elseif action.icon == 'csv' %}
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                                </svg>
                            {% elseif action.icon == 'theme' %}
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
                                </svg>
                            {% elseif action.icon == 'users' %}
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                                </svg>
                            {% endif %}
                        </div>
                        <div class="flex-1">
                            <h3 class="font-medium text-sm mb-1 text-base-content">{{ action.title|trans }}</h3>
                            <p class="text-xs text-base-content/60">{{ action.description|trans }}</p>
                        </div>
                    </div>
                </a>
            {% endfor %}
        </div>
    </div>

    {# Articles récents #}
    {% if recent_articles|length > 0 %}
    <div class="mb-12">
        <div class="flex justify-between items-center mb-6">
            <h2 class="text-xl font-medium text-base-content">{{ 'dashboard.recent_articles.title'|trans }}</h2>
            {% if is_granted('ROLE_AUTEUR') or is_granted('ROLE_EDITEUR') or is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_article_index') }}" class="text-sm text-base-content/60 hover:text-base-content transition-colors flex items-center gap-1">
                    {{ 'button.view_all'|trans }}
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                </a>
            {% endif %}
        </div>
        <div class="border border-base-300 rounded-lg overflow-hidden bg-base-100">
            <table class="w-full">
                <thead class="border-b border-base-300">
                    <tr class="text-left">
                        <th class="px-6 py-3 text-xs font-medium text-base-content/60">{{ 'dashboard.recent_articles.table.title'|trans }}</th>
                        <th class="px-6 py-3 text-xs font-medium text-base-content/60">{{ 'dashboard.recent_articles.table.author'|trans }}</th>
                        <th class="px-6 py-3 text-xs font-medium text-base-content/60">{{ 'dashboard.recent_articles.table.date'|trans }}</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-base-300">
                    {% for article in recent_articles %}
                    <tr class="hover:bg-base-200/50 transition-colors">
                        <td class="px-6 py-4">
                            <p class="text-sm font-medium text-base-content">{{ article.title }}</p>
                        </td>
                        <td class="px-6 py-4">
                            <p class="text-sm text-base-content/70">{{ article.author.prenom }} {{ article.author.nom }}</p>
                        </td>
                        <td class="px-6 py-4">
                            <p class="text-sm text-base-content/60">{{ article.createdAt|date('d/m/Y') }}</p>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    {% endif %}

    {# Conseils d'utilisation #}
    <div class="border border-base-300 rounded-lg p-6 bg-base-100">
        <div class="flex items-start gap-3">
            <div class="w-8 h-8 flex items-center justify-center text-base-content/40">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
            </div>
            <div>
                <p class="font-medium text-sm text-base-content mb-1">{{ 'dashboard.tip.label'|trans }}</p>
                <p class="text-xs text-base-content/60 leading-relaxed">
                    {{ 'dashboard.tip.text'|trans }}
                </p>
            </div>
        </div>
    </div>
</div>
{% endblock %}
