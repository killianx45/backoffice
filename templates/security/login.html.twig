{% extends 'base.html.twig' %}

{% block title %}Log in!{% endblock %}

{% block body %}
    <div class="min-h-screen flex items-center justify-center">
        <div class="card w-full max-w-md bg-base-100 shadow-xl">
            <div class="card-body">
                <h2 class="card-title text-2xl font-bold text-center justify-center mb-4">
                    Sign in
                </h2>

                {% if error %}
                    <div class="alert alert-error mb-4">
                        <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        <span>{{ error.messageKey|trans(error.messageData, 'security') }}</span>
                    </div>
                {% endif %}

                {% if app.user %}
                    <div class="alert alert-info mb-4">
                        <span>You are logged in as {{ app.user.userIdentifier }}, <a href="{{ path('app_logout') }}" class="link">Logout</a></span>
                    </div>
                {% endif %}

                <form method="post">
                    <div class="form-control mb-4">
                        <label class="label" for="username">
                            <span class="label-text">Email</span>
                        </label>
                        <input
                            type="email"
                            value="{{ last_username }}"
                            name="_username"
                            id="username"
                            class="input input-bordered w-full"
                            autocomplete="email"
                            required
                            autofocus
                            placeholder="your@email.com"
                        >
                    </div>

                    <div class="form-control mb-4">
                        <label class="label" for="password">
                            <span class="label-text">Password</span>
                        </label>
                        <input
                            type="password"
                            name="_password"
                            id="password"
                            class="input input-bordered w-full"
                            autocomplete="current-password"
                            required
                            placeholder="••••••••"
                        >
                    </div>

                    <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

                    {#
                    <div class="form-control mb-4">
                        <label class="label cursor-pointer justify-start gap-2">
                            <input type="checkbox" name="_remember_me" id="_remember_me" class="checkbox checkbox-primary">
                            <span class="label-text">Remember me</span>
                        </label>
                    </div>
                    #}

                    <div class="card-actions justify-end mt-6">
                        <button class="btn btn-primary w-full" type="submit">
                            Sign in
                        </button>
                    </div>
                </form>

                <div class="divider">OR</div>

                <div class="text-center">
                    <p class="text-sm">
                        Don't have an account?
                        <a href="{{ path('app_register') }}" class="link link-primary">Register here</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
