{% extends 'base.html.twig' %}

{% block title %}{{ 'login.title'|trans }}{% endblock %}

{% block body %}
    <div class="min-h-screen flex items-center justify-center px-4 py-8 sm:px-6 sm:py-12 bg-base-100">
        <div class="w-full max-w-md border border-base-300 rounded-lg p-4 sm:p-8 bg-base-100">
            <div class="mb-8">
                <h2 class="text-2xl font-semibold text-base-content text-center">
                    {{ 'login.title'|trans }}
                </h2>
            </div>

            {% for message in app.flashes('error') %}
                <div class="border border-base-content/20 bg-base-100 rounded-lg p-4 mb-6 flex items-start gap-3">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-base-content/60 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <span class="text-sm text-base-content/80">{{ message }}</span>
                </div>
            {% endfor %}

            {% if error %}
                <div class="border border-base-content/20 bg-base-100 rounded-lg p-4 mb-6 flex items-start gap-3">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-base-content/60 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <span class="text-sm text-base-content/80">{{ error.messageKey|trans(error.messageData, 'security') }}</span>
                </div>
            {% endif %}

            {% if app.user %}
                <div class="border border-base-300 bg-base-100 rounded-lg p-4 mb-6">
                    <span class="text-sm text-base-content/80">{{ 'login.already_logged_in'|trans({'%username%': app.user.userIdentifier}) }} <a href="{{ path('app_logout') }}" class="text-base-content underline hover:no-underline">{{ 'nav.logout'|trans }}</a></span>
                </div>
            {% endif %}

            <form method="post">
                <div class="mb-6">
                    <label class="block text-sm font-medium text-base-content mb-2" for="username">
                        {{ 'login.email.label'|trans({}, 'security') }}
                    </label>
                    <input
                        type="email"
                        value="{{ last_username }}"
                        name="_username"
                        id="username"
                        class="w-full px-4 py-2 border border-base-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-base-content/20 text-sm bg-base-100"
                        autocomplete="email"
                        required
                        autofocus
                        placeholder="{{ 'login.email.placeholder'|trans({}, 'security') }}"
                    >
                </div>

                <div class="mb-6">
                    <label class="block text-sm font-medium text-base-content mb-2" for="password">
                        {{ 'login.password.label'|trans({}, 'security') }}
                    </label>
                    <input
                        type="password"
                        name="_password"
                        id="password"
                        class="w-full px-4 py-2 border border-base-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-base-content/20 text-sm bg-base-100"
                        autocomplete="current-password"
                        required
                        placeholder="{{ 'login.password.placeholder'|trans({}, 'security') }}"
                    >
                </div>

                <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

                <button class="w-full border border-base-content bg-base-content text-base-100 hover:opacity-90 transition-opacity px-4 py-2 rounded-lg text-sm font-medium mt-2" type="submit">
                    {{ 'login.button.submit'|trans({}, 'security') }}
                </button>
            </form>

        </div>
    </div>
{% endblock %}
