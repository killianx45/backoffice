{% extends 'base.html.twig' %}

{% block title %}Gestion des Utilisateurs{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-8">
    <div class="flex justify-between items-center mb-8">
        <h1 class="text-3xl font-bold">Gestion des Utilisateurs</h1>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 shrink-0 stroke-current" fill="none" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>{{ message }}</span>
        </div>
    {% endfor %}

    <div class="overflow-x-auto bg-base-200 rounded-lg shadow-lg">
        <table class="table table-zebra w-full">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nom</th>
                    <th>Prénom</th>
                    <th>Email</th>
                    <th>Rôles</th>
                    <th>Vérifié</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for user in users %}
                <tr>
                    <td>{{ user.id }}</td>
                    <td>{{ user.nom }}</td>
                    <td>{{ user.prenom }}</td>
                    <td>{{ user.email }}</td>
                    <td>
                        <div class="flex flex-wrap gap-1">
                            {% for role in user.roles %}
                                {% if role != 'ROLE_ABONNE' %}
                                    <span class="badge badge-primary badge-sm">{{ role|replace({'ROLE_': ''}) }}</span>
                                {% endif %}
                            {% endfor %}
                            {% if user.roles|length == 1 %}
                                <span class="badge badge-ghost badge-sm">ABONNE</span>
                            {% endif %}
                        </div>
                    </td>
                    <td>
                        {% if user.isVerified %}
                            <span class="badge badge-success badge-sm">✓ Vérifié</span>
                        {% else %}
                            <span class="badge badge-warning badge-sm">Non vérifié</span>
                        {% endif %}
                    </td>
                    <td>
                        <button
                            class="btn btn-sm btn-primary"
                            onclick="openRoleModal{{ user.id }}()"
                        >
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                            </svg>
                            Modifier rôles
                        </button>

                        {# Modal for editing roles #}
                        <dialog id="role_modal_{{ user.id }}" class="modal">
                            <div class="modal-box">
                                <h3 class="text-lg font-bold mb-4">Modifier les rôles de {{ user.prenom }} {{ user.nom }}</h3>

                                <form method="post" action="{{ path('app_user_update_roles', {'id': user.id}) }}">
                                    <div class="form-control">
                                        <label class="label cursor-pointer justify-start gap-3">
                                            <input
                                                type="checkbox"
                                                name="roles[]"
                                                value="ROLE_AUTEUR"
                                                class="checkbox checkbox-primary"
                                                {% if 'ROLE_AUTEUR' in user.roles %}checked{% endif %}
                                            />
                                            <span class="label-text">Auteur</span>
                                        </label>

                                        <label class="label cursor-pointer justify-start gap-3">
                                            <input
                                                type="checkbox"
                                                name="roles[]"
                                                value="ROLE_EDITEUR"
                                                class="checkbox checkbox-primary"
                                                {% if 'ROLE_EDITEUR' in user.roles %}checked{% endif %}
                                            />
                                            <span class="label-text">Éditeur</span>
                                        </label>

                                        <label class="label cursor-pointer justify-start gap-3">
                                            <input
                                                type="checkbox"
                                                name="roles[]"
                                                value="ROLE_FOURNISSEUR"
                                                class="checkbox checkbox-primary"
                                                {% if 'ROLE_FOURNISSEUR' in user.roles %}checked{% endif %}
                                            />
                                            <span class="label-text">Fournisseur</span>
                                        </label>

                                        <label class="label cursor-pointer justify-start gap-3">
                                            <input
                                                type="checkbox"
                                                name="roles[]"
                                                value="ROLE_DESIGNEUR"
                                                class="checkbox checkbox-primary"
                                                {% if 'ROLE_DESIGNEUR' in user.roles %}checked{% endif %}
                                            />
                                            <span class="label-text">Designer</span>
                                        </label>

                                        <label class="label cursor-pointer justify-start gap-3">
                                            <input
                                                type="checkbox"
                                                name="roles[]"
                                                value="ROLE_ADMIN"
                                                class="checkbox checkbox-primary"
                                                {% if 'ROLE_ADMIN' in user.roles %}checked{% endif %}
                                            />
                                            <span class="label-text">Administrateur</span>
                                        </label>
                                    </div>

                                    <div class="modal-action">
                                        <button type="button" class="btn" onclick="document.getElementById('role_modal_{{ user.id }}').close()">Annuler</button>
                                        <button type="submit" class="btn btn-primary">Enregistrer</button>
                                    </div>
                                </form>
                            </div>
                            <form method="dialog" class="modal-backdrop">
                                <button>close</button>
                            </form>
                        </dialog>

                        <script>
                            function openRoleModal{{ user.id }}() {
                                document.getElementById('role_modal_{{ user.id }}').showModal();
                            }
                        </script>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="7" class="text-center py-8">
                        <p class="text-base-content/60">Aucun utilisateur trouvé.</p>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
