{% extends 'base.html.twig' %}

{% block title %}{{ 'user.title.list'|trans }}{% endblock %}

{% block body %}
<div class="container mx-auto px-6 py-12 max-w-7xl">
    <div class="mb-8">
        <h1 class="text-3xl font-semibold text-base-content">{{ 'user.title.list'|trans }}</h1>
        <p class="text-sm text-base-content/60 mt-1">{{ 'user.subtitle.list'|trans }}</p>
    </div>

    {% for message in app.flashes('success') %}
        <div class="border border-base-300 bg-base-100 rounded-lg p-4 mb-6 flex items-center gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-base-content/60" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span class="text-sm text-base-content/80">{{ message }}</span>
        </div>
    {% endfor %}

    <div class="border border-base-300 rounded-lg overflow-hidden bg-base-100">
        <table class="w-full">
            <thead class="border-b border-base-300">
                <tr class="text-left">
                    <th class="px-6 py-3 text-xs font-medium text-base-content/60">{{ 'user.table.id'|trans }}</th>
                    <th class="px-6 py-3 text-xs font-medium text-base-content/60">{{ 'user.table.last_name'|trans }}</th>
                    <th class="px-6 py-3 text-xs font-medium text-base-content/60">{{ 'user.table.first_name'|trans }}</th>
                    <th class="px-6 py-3 text-xs font-medium text-base-content/60">{{ 'user.table.email'|trans }}</th>
                    <th class="px-6 py-3 text-xs font-medium text-base-content/60">{{ 'user.table.roles'|trans }}</th>
                    <th class="px-6 py-3 text-xs font-medium text-base-content/60">{{ 'user.table.status'|trans }}</th>
                    <th class="px-6 py-3 text-xs font-medium text-base-content/60">{{ 'user.table.actions'|trans }}</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-base-300">
                {% for user in users %}
                <tr class="hover:bg-base-200/50 transition-colors">
                    <td class="px-6 py-4 text-sm text-base-content/70">{{ user.id }}</td>
                    <td class="px-6 py-4 text-sm text-base-content">{{ user.nom }}</td>
                    <td class="px-6 py-4 text-sm text-base-content">{{ user.prenom }}</td>
                    <td class="px-6 py-4 text-sm text-base-content/70">{{ user.email }}</td>
                    <td class="px-6 py-4">
                        <div class="flex flex-wrap gap-1">
                            {% for role in user.roles %}
                                {% if role != 'ROLE_ABONNE' %}
                                    {% set roleKey = role|replace({'ROLE_': ''})|lower %}
                                    <span class="text-xs px-2 py-1 border border-base-300 rounded text-base-content/70">{{ ('user.role.' ~ roleKey)|trans }}</span>
                                {% endif %}
                            {% endfor %}
                            {% if user.roles|length == 1 %}
                                <span class="text-xs px-2 py-1 border border-base-300 rounded text-base-content/50">{{ 'user.role.abonne'|trans }}</span>
                            {% endif %}
                        </div>
                    </td>
                    <td class="px-6 py-4">
                        {% if user.isVerified %}
                            <span class="text-xs text-base-content/60">{{ 'user.status.verified'|trans }}</span>
                        {% else %}
                            <span class="text-xs text-base-content/40">{{ 'user.status.not_verified'|trans }}</span>
                        {% endif %}
                    </td>
                    <td class="px-6 py-4">
                        <div class="flex items-center gap-3">
                            <button
                                class="text-sm text-base-content/60 hover:text-base-content transition-colors flex items-center gap-1"
                                onclick="openRoleModal{{ user.id }}()"
                            >
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                </svg>
                                {{ 'button.edit'|trans }}
                            </button>

                            {% if app.user.id != user.id %}
                            <button
                                class="text-sm text-red-600/60 hover:text-red-600 transition-colors flex items-center gap-1"
                                onclick="openDeleteModal{{ user.id }}()"
                            >
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                </svg>
                                {{ 'button.delete'|trans }}
                            </button>
                            {% endif %}
                        </div>

                        {# Modal for editing roles #}
                        <dialog id="role_modal_{{ user.id }}" class="modal">
                            <div class="modal-box border border-base-300 bg-base-100 shadow-lg">
                                <h3 class="text-lg font-medium text-base-content mb-6">{{ 'user.modal.edit_roles'|trans({'%name%': user.prenom ~ ' ' ~ user.nom}) }}</h3>

                                <form method="post" action="{{ path('app_user_update_roles', {'id': user.id}) }}">
                                    <div class="space-y-3">
                                        <label class="flex items-center gap-3 cursor-pointer p-3 border border-base-300 rounded-lg hover:bg-base-200/50 transition-colors">
                                            <input
                                                type="checkbox"
                                                name="roles[]"
                                                value="ROLE_AUTEUR"
                                                class="w-4 h-4 border-2 border-base-300 rounded"
                                                {% if 'ROLE_AUTEUR' in user.roles %}checked{% endif %}
                                            />
                                            <span class="text-sm text-base-content">{{ 'user.role.auteur'|trans }}</span>
                                        </label>

                                        <label class="flex items-center gap-3 cursor-pointer p-3 border border-base-300 rounded-lg hover:bg-base-200/50 transition-colors">
                                            <input
                                                type="checkbox"
                                                name="roles[]"
                                                value="ROLE_EDITEUR"
                                                class="w-4 h-4 border-2 border-base-300 rounded"
                                                {% if 'ROLE_EDITEUR' in user.roles %}checked{% endif %}
                                            />
                                            <span class="text-sm text-base-content">{{ 'user.role.editeur'|trans }}</span>
                                        </label>

                                        <label class="flex items-center gap-3 cursor-pointer p-3 border border-base-300 rounded-lg hover:bg-base-200/50 transition-colors">
                                            <input
                                                type="checkbox"
                                                name="roles[]"
                                                value="ROLE_FOURNISSEUR"
                                                class="w-4 h-4 border-2 border-base-300 rounded"
                                                {% if 'ROLE_FOURNISSEUR' in user.roles %}checked{% endif %}
                                            />
                                            <span class="text-sm text-base-content">{{ 'user.role.fournisseur'|trans }}</span>
                                        </label>

                                        <label class="flex items-center gap-3 cursor-pointer p-3 border border-base-300 rounded-lg hover:bg-base-200/50 transition-colors">
                                            <input
                                                type="checkbox"
                                                name="roles[]"
                                                value="ROLE_DESIGNEUR"
                                                class="w-4 h-4 border-2 border-base-300 rounded"
                                                {% if 'ROLE_DESIGNEUR' in user.roles %}checked{% endif %}
                                            />
                                            <span class="text-sm text-base-content">{{ 'user.role.designeur'|trans }}</span>
                                        </label>

                                        <label class="flex items-center gap-3 cursor-pointer p-3 border border-base-300 rounded-lg hover:bg-base-200/50 transition-colors">
                                            <input
                                                type="checkbox"
                                                name="roles[]"
                                                value="ROLE_ADMIN"
                                                class="w-4 h-4 border-2 border-base-300 rounded"
                                                {% if 'ROLE_ADMIN' in user.roles %}checked{% endif %}
                                            />
                                            <span class="text-sm text-base-content">{{ 'user.role.admin'|trans }}</span>
                                        </label>
                                    </div>

                                    <div class="flex gap-3 mt-6 justify-end">
                                        <button type="button" class="px-4 py-2 text-sm border border-base-300 rounded-lg hover:bg-base-200 transition-colors" onclick="document.getElementById('role_modal_{{ user.id }}').close()">{{ 'button.cancel'|trans }}</button>
                                        <button type="submit" class="px-4 py-2 text-sm border border-base-content bg-base-content text-base-100 rounded-lg hover:opacity-90 transition-opacity">{{ 'button.save'|trans }}</button>
                                    </div>
                                </form>
                            </div>
                            <form method="dialog" class="modal-backdrop">
                                <button>close</button>
                            </form>
                        </dialog>
                        {% if app.user.id != user.id %}
                        <dialog id="delete_modal_{{ user.id }}" class="modal">
                            <div class="modal-box border border-base-300 bg-base-100 shadow-lg">
                                <h3 class="text-lg font-medium text-base-content mb-4">{{ 'user.modal.delete_confirm'|trans }}</h3>

                                <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-lg">
                                    <p class="text-sm text-red-800 mb-2 font-medium">{{ 'user.modal.delete_warning'|trans }}</p>
                                    <p class="text-sm text-red-700">{{ 'user.modal.delete_user_name'|trans({'%name%': user.prenom ~ ' ' ~ user.nom}) }}</p>
                                    <ul class="mt-3 text-sm text-red-700 space-y-1 list-disc list-inside">
                                        <li>{{ 'user.modal.delete_articles'|trans }}</li>
                                        <li>{{ 'user.modal.delete_ratings'|trans }}</li>
                                        <li>{{ 'user.modal.delete_datasets'|trans }}</li>
                                        <li>{{ 'user.modal.delete_personal_data'|trans }}</li>
                                    </ul>
                                </div>

                                <form method="post" action="{{ path('app_user_delete', {'id': user.id}) }}">
                                    <div class="flex gap-3 justify-end">
                                        <button type="button" class="px-4 py-2 text-sm border border-base-300 rounded-lg hover:bg-base-200 transition-colors" onclick="document.getElementById('delete_modal_{{ user.id }}').close()">{{ 'button.cancel'|trans }}</button>
                                        <button type="submit" class="px-4 py-2 text-sm border-2 border-red-600 bg-red-600 text-white rounded-lg hover:bg-red-700 hover:border-red-700 transition-colors font-medium">{{ 'button.delete_confirm'|trans }}</button>
                                    </div>
                                </form>
                            </div>
                            <form method="dialog" class="modal-backdrop">
                                <button>close</button>
                            </form>
                        </dialog>

                        <script>
                            function openDeleteModal{{ user.id }}() {
                                document.getElementById('delete_modal_{{ user.id }}').showModal();
                            }
                        </script>
                        {% endif %}

                        <script>
                            function openRoleModal{{ user.id }}() {
                                document.getElementById('role_modal_{{ user.id }}').showModal();
                            }
                        </script>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="7" class="text-center py-12">
                        <p class="text-sm text-base-content/60">{{ 'user.no_users'|trans }}</p>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
