{% set position = position|default('fixed') %}

<div data-controller="chatbot" data-chatbot-api-url-value="/api/chat" class="chatbot-container">
    <button
        data-chatbot-target="toggleButton"
        data-action="click->chatbot#toggleWidget"
        class="btn btn-circle btn-primary fixed bottom-6 right-6 shadow-lg hover:shadow-xl transition-all z-50"
        title="Chat Assistant"
    >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
        </svg>
    </button>

    <div
        data-chatbot-target="widget"
        class="fixed bottom-24 right-6 w-96 h-[32rem] bg-base-100 rounded-lg shadow-2xl flex flex-col z-50 border border-base-300 hidden"
    >
        <div class="flex items-center justify-between p-4 border-b border-base-300 bg-base-200 rounded-t-lg">
            <div class="flex items-center gap-2">
                <div class="w-2 h-2 bg-success rounded-full animate-pulse"></div>
                <h3 class="font-semibold text-base-content">CMS Assistant</h3>
            </div>
            <button
                data-action="click->chatbot#toggleWidget"
                class="btn btn-ghost btn-sm btn-circle"
                title="Close"
            >
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>

        <div
            data-chatbot-target="chatLog"
            class="flex-1 overflow-y-auto p-4 space-y-4 bg-base-100"
        >
            <div class="chat chat-start">
                <div class="chat-bubble chat-bubble-neutral">
                    Hello! I'm here to help you with the CMS. Ask me anything about managing articles, users, media, or datasets.
                </div>
            </div>
        </div>

        <div class="p-4 border-t border-base-300 bg-base-100 rounded-b-lg">
            <div data-chatbot-target="loader" class="hidden mb-2">
                <div class="flex items-center gap-2 text-sm text-base-content/60">
                    <span class="loading loading-dots loading-sm"></span>
                    <span>Thinking...</span>
                </div>
            </div>

            <form data-action="submit->chatbot#sendMessage" class="flex gap-2">
                <input
                    type="text"
                    data-chatbot-target="input"
                    data-action="keypress->chatbot#handleKeyPress"
                    placeholder="Ask me anything..."
                    class="input input-bordered flex-1 input-sm"
                    maxlength="1000"
                />
                <button
                    type="submit"
                    data-chatbot-target="sendButton"
                    class="btn btn-primary btn-sm"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
                    </svg>
                </button>
            </form>
        </div>
    </div>
</div>

<style>
    @keyframes fade-in {
        from {
            opacity: 0;
            transform: translateY(10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .animate-fade-in {
        animation: fade-in 0.2s ease-out;
    }
</style>
