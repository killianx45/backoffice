{% set stats = article_rating_stats(article) %}
{% set average = stats.average %}
{% set count = stats.count %}

{% if count > 0 %}
<div class="flex items-center gap-2 text-sm">
    <div class="flex items-center">
        {% for i in 1..5 %}
            {% set isFilled = i <= average|round(0, 'floor') %}
            {% set isHalf = i == (average|round(0, 'floor') + 1) and (average % 1) >= 0.5 %}
            
            <div class="relative w-4 h-4">
                <svg class="w-4 h-4 absolute top-0 left-0" fill="none" stroke="#d1d5db" stroke-width="1.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" />
                </svg>
                
                {% if isFilled %}
                    <svg class="w-4 h-4 absolute top-0 left-0" fill="#fbbf24" stroke="#f59e0b" stroke-width="1.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" />
                    </svg>
                {% elseif isHalf %}
                    <div class="absolute top-0 left-0 overflow-hidden" style="width: 50%;">
                        <svg class="w-4 h-4" fill="#fbbf24" stroke="#f59e0b" stroke-width="1.5" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" />
                        </svg>
                    </div>
                {% endif %}
            </div>
        {% endfor %}
    </div>
    
    <span class="text-base-content/60">
        <span class="font-medium">{{ average|number_format(1, ',', ' ') }}</span>
        <span class="text-xs">({{ count }} avis)</span>
    </span>
</div>
{% else %}
<div class="flex items-center gap-2 text-sm text-base-content/40">
    <div class="flex items-center">
        {% for i in 1..5 %}
            <svg class="w-4 h-4" fill="none" stroke="#e5e7eb" stroke-width="1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" />
            </svg>
        {% endfor %}
    </div>
    <span class="text-xs">Aucun avis</span>
</div>
{% endif %}