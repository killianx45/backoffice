{{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}

<div class="form-control">
    {{ form_label(form.title, null, {'label_attr': {'class': 'label'}}) }}
    {{ form_widget(form.title) }}
    {{ form_errors(form.title) }}
</div>

<div class="form-control">
    <label class="label">
        <span class="label-text">Description</span>
    </label>
    <div id="ckeditor-editor"
         data-controller="ckeditor5"
         data-ckeditor5-content-value="{{ form.description.vars.value|default('')|e('html_attr') }}"
         data-ckeditor5-target="editor"
         class="border border-base-300 rounded-lg min-h-[300px] bg-base-100">
        {{ form_widget(form.description) }}
    </div>
    {{ form_errors(form.description) }}
</div>

<div class="form-control" data-controller="media-manager">
    {{ form_label(form.featuredImageFile, null, {'label_attr': {'class': 'label'}}) }}
    <div class="flex gap-2">
        <button type="button"
                data-action="media-manager#openModal"
                class="btn btn-outline">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Zm10.5-11.25h.008v.008h-.008V8.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
            </svg>
            Sélectionner une image
        </button>
        <div data-media-manager-target="preview" class="flex-1"></div>
    </div>
    {{ form_widget(form.featuredImage) }}
    {{ form_widget(form.featuredImageFile, {'attr': {'class': 'hidden', 'accept': 'image/*'}}) }}
    {{ form_errors(form.featuredImageFile) }}
</div>

<div class="divider">Graphiques (optionnel)</div>

<div class="card bg-base-100 border border-base-300">
    <div class="card-body">
        <h3 class="card-title text-base">Ajouter des graphiques</h3>
        <p class="text-sm text-base-content/70 mb-4">Vous pouvez ajouter plusieurs graphiques à votre article en sélectionnant des fichiers CSV.</p>

        <div data-controller="article-charts"
             data-article-charts-index-value="{{ form.charts.children|length }}"
             data-article-charts-prototype-value="{{ form_widget(form.charts.vars.prototype)|e('html_attr') }}">
            <div data-article-charts-target="chartsContainer">
                {% for chartForm in form.charts %}
                    <div class="card bg-base-200 mb-4" data-article-charts-target="chartItem">
                        <div class="card-body p-4">
                            <div class="flex justify-between items-center mb-3">
                                <h4 class="font-medium">Graphique #<span data-article-charts-target="chartNumber">{{ loop.index }}</span></h4>
                                <button type="button" class="btn btn-sm btn-ghost btn-circle" data-action="click->article-charts#removeChart">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                                    </svg>
                                </button>
                            </div>

                            <div class="grid grid-cols-1 gap-4" data-controller="csv-manager">
                                <div class="form-control">
                                    <label class="label">
                                        <span class="label-text">Fichier CSV</span>
                                    </label>
                                    <button type="button"
                                            data-action="csv-manager#openModal"
                                            class="btn btn-outline btn-sm">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                                        </svg>
                                        Sélectionner un CSV
                                    </button>
                                    <div data-csv-manager-target="preview" class="mt-2"></div>
                                    {{ form_widget(chartForm.csvFile) }}
                                </div>

                                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                                    <div class="form-control">
                                        {{ form_label(chartForm.chartType, null, {'label_attr': {'class': 'label'}}) }}
                                        {{ form_widget(chartForm.chartType) }}
                                    </div>

                                    <div class="form-control">
                                        {{ form_label(chartForm.title, null, {'label_attr': {'class': 'label'}}) }}
                                        {{ form_widget(chartForm.title) }}
                                    </div>

                                    <div class="form-control">
                                        {{ form_label(chartForm.displayOrder, null, {'label_attr': {'class': 'label'}}) }}
                                        {{ form_widget(chartForm.displayOrder) }}
                                    </div>
                                </div>

                                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4">
                                    <div class="form-control">
                                        {{ form_label(chartForm.xAxisLabel, null, {'label_attr': {'class': 'label'}}) }}
                                        {{ form_widget(chartForm.xAxisLabel) }}
                                    </div>

                                    <div class="form-control">
                                        {{ form_label(chartForm.yAxisLabel, null, {'label_attr': {'class': 'label'}}) }}
                                        {{ form_widget(chartForm.yAxisLabel) }}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>

            <button type="button"
                    class="btn btn-outline btn-sm mt-2"
                    data-action="click->article-charts#addChart">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                </svg>
                Ajouter un graphique
            </button>
        </div>
    </div>
</div>

<div class="flex gap-2 justify-end pt-4">
    <a href="{{ path('app_article_index') }}" class="btn btn-ghost">Annuler</a>
    <button type="submit" class="btn btn-primary">{{ button_label|default('Enregistrer') }}</button>
</div>

{{ form_end(form) }}
