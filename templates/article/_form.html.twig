{{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}

<div class="form-control">
    {{ form_label(form.title, null, {'label_attr': {'class': 'label'}}) }}
    {{ form_widget(form.title) }}
    {{ form_errors(form.title) }}
</div>

<div class="form-control">
    <label class="label">
        <span class="label-text">{{ 'article.label.tags'|trans({}, 'forms') }}</span>
    </label>
    {{ form_widget(form.tags, {'attr': {'class': 'select select-bordered w-full'}}) }}
    {{ form_errors(form.tags) }}
</div>

<div class="form-control">
    <label class="label">
        <span class="label-text">{{ 'article.label.description'|trans({}, 'forms') }}</span>
    </label>
    <div id="ckeditor-editor"
         data-controller="ckeditor5"
         data-ckeditor5-content-value="{{ form.description.vars.value|default('')|e('html_attr') }}"
         data-ckeditor5-target="editor"
         class="border border-base-300 rounded-lg min-h-[300px] bg-base-100">
        {{ form_widget(form.description) }}
    </div>
    {{ form_errors(form.description) }}
</div>

<div class="form-control">
    {{ form_label(form.featuredImageFile, null, {'label_attr': {'class': 'label'}}) }}
    <div class="flex gap-2">
        <button type="button"
                data-action="media-manager#openModal"
                class="btn btn-outline">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Zm10.5-11.25h.008v.008h-.008V8.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
            </svg>
            {{ 'article.button.select_image'|trans({}, 'forms') }}
        </button>
        <div data-media-manager-target="preview" class="flex-1"></div>
    </div>
    {{ form_widget(form.featuredImage) }}
    {{ form_widget(form.featuredImageFile, {'attr': {'class': 'hidden', 'accept': 'image/*'}}) }}
    {{ form_errors(form.featuredImageFile) }}
</div>

<div class="flex flex-col sm:flex-row gap-2 sm:justify-end pt-4">
    <a href="{{ path('app_article_index') }}" class="btn btn-ghost w-full sm:w-auto">{{ 'button.cancel'|trans }}</a>
    <button type="submit" class="btn btn-primary w-full sm:w-auto">{{ button_label|default('button.save'|trans) }}</button>
</div>

{{ form_end(form) }}
