{% extends 'base.html.twig' %}

{% block title %}{{ 'article.title.list'|trans }}{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-8 sm:px-6 sm:py-12 max-w-7xl">
    <div class="flex flex-col gap-4 sm:flex-row sm:justify-between sm:items-center mb-8">
        <div>
            <h1 class="text-3xl font-semibold text-base-content">{{ 'article.title.list'|trans }}</h1>
            <p class="text-sm text-base-content/60 mt-1">{{ 'article.subtitle.list'|trans }}</p>
        </div>
        {% if is_granted('ROLE_AUTEUR') %}
        <a href="{{ path('app_article_new') }}" class="border border-base-content text-base-content hover:bg-base-content hover:text-base-100 transition-colors px-4 py-2 rounded-lg text-sm font-medium flex items-center justify-center gap-2 w-full sm:w-auto">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
            </svg>
            {{ 'article.title.new'|trans }}
        </a>
        {% endif %}
    </div>

    {% for message in app.flashes('success') %}
        <div class="border border-base-300 bg-base-100 rounded-lg p-4 mb-6 flex items-center gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-base-content/60" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span class="text-sm text-base-content/80">{{ message }}</span>
        </div>
    {% endfor %}

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {% for article in articles %}
        <a href="{{ path('app_article_show', {'id': article.id}) }}" class="group border border-base-300 rounded-lg overflow-hidden hover:border-base-content/20 transition-colors bg-base-100 flex flex-col">
            {% if article.featuredImage %}
            <div class="aspect-video bg-base-200">
                <img src="{{ vich_uploader_asset(article, 'featuredImageFile') }}" alt="{{ article.title }}" class="w-full h-full object-cover">
            </div>
            {% endif %}

            <div class="p-5 flex flex-col flex-1">
                <h2 class="text-lg font-medium text-base-content mb-3 group-hover:text-base-content/80 transition-colors">
                    {{ article.title }}
                </h2>

                {% if article.tags|length > 0 %}
                <div class="flex flex-wrap gap-2 mb-4">
                    {% for tag in article.tags %}
                        <span class="badge" style="border-color: {{ tag.color }}; color: {{ tag.color }}">
                            {{ tag.nom }}
                        </span>
                    {% endfor %}
                </div>
                {% endif %}

                <div class="text-xs text-base-content/60 space-y-1 mb-4">
                    <p>{{ 'article.by_author'|trans({'%author%': article.author.prenom ~ ' ' ~ article.author.nom}) }}</p>
                    <p>{{ article.createdAt|date('d/m/Y') }}</p>
                    <div class="pt-2">
                        {% include 'components/star_rating.html.twig' with {'article': article} %}
                    </div>
                </div>

                {% if is_granted('ARTICLE_EDIT', article) %}
                <div class="pt-3 border-t border-base-300 mt-auto">
                    <span class="text-sm text-base-content/60 group-hover:text-base-content transition-colors flex items-center gap-1" onclick="event.preventDefault(); event.stopPropagation(); window.location.href='{{ path('app_article_edit', {'id': article.id}) }}'">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                        </svg>
                        {{ 'button.edit'|trans }}
                    </span>
                </div>
                {% endif %}
            </div>
        </a>
        {% else %}
        <div class="col-span-full border border-base-300 rounded-lg p-8 text-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 mx-auto mb-4 text-base-content/20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            <p class="text-base-content/60 text-sm">{{ 'article.no_articles'|trans }}</p>
        </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
