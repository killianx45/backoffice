{% extends 'base.html.twig' %}

{% block title %}{{ 'article.title.new'|trans }}{% endblock %}

{% block dns_prefetch %}
<link rel="dns-prefetch" href="https://cdn.ckeditor.com" />
<link rel="preconnect" href="https://cdn.ckeditor.com" crossorigin />
{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-8 max-w-4xl">
    <div class="mb-8">
        <h1 class="text-3xl font-bold text-base-content">{{ 'article.title.create'|trans }}</h1>
        <p class="text-base-content/70 mt-2">{{ 'article.subtitle.new'|trans }}</p>
    </div>

    <div class="card bg-base-100 shadow-sm border border-base-300">
        <div class="card-body">
            {{ include('article/_form.html.twig', {'button_label': 'article.title.create'|trans({}, 'messages')}) }}
        </div>
    </div>
</div>
{% endblock %}
