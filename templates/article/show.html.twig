{% extends 'base.html.twig' %}

{% block title %}{{ article.title }}{% endblock %}

{% set theme = active_theme() %}
{% set themeConfig = theme ? theme.configuration : null %}

{% block body %}
<div class="container mx-auto px-6 py-12"
     style="max-width: {% if themeConfig and themeConfig.layout.articleWidth == 'narrow' %}600px{% elseif themeConfig and themeConfig.layout.articleWidth == 'medium' %}800px{% elseif themeConfig and themeConfig.layout.articleWidth == 'wide' %}1200px{% else %}800px{% endif %};">
    <div class="mb-8 flex justify-between items-start">
        <div class="flex-1">
            <h1 class="text-3xl font-semibold text-base-content mb-3">{{ article.title }}</h1>

            <div class="flex items-center gap-3 text-sm text-base-content/60">
                <div class="flex items-center gap-2">
                    <div class="w-7 h-7 rounded-full bg-base-300 flex items-center justify-center overflow-hidden">
                        {% if article.author.avatar %}
                            <img src="{{ asset('uploads/avatars/' ~ article.author.avatar) }}" alt="Avatar de {{ article.author.prenom }}" class="w-full h-full object-cover">
                        {% else %}
                            <span class="text-xs font-medium text-base-content/70">{{ article.author.prenom|first }}{{ article.author.nom|first }}</span>
                        {% endif %}
                    </div>
                    <span>{{ article.author.prenom }} {{ article.author.nom }}</span>
                </div>
                <span class="text-base-content/40">•</span>
                <span>{{ article.createdAt|date('d/m/Y') }}</span>
                {% if article.createdAt != article.updatedAt %}
                <span class="text-xs text-base-content/40">(modifié le {{ article.updatedAt|date('d/m/Y') }})</span>
                {% endif %}
            </div>
        </div>

        <div class="flex gap-2">
            <a href="{{ path('app_article_index') }}" class="text-sm text-base-content/60 hover:text-base-content transition-colors px-3 py-2">Retour</a>
            {% if is_granted('ARTICLE_EDIT', article) %}
            <a href="{{ path('app_article_edit', {'id': article.id}) }}" class="text-sm border border-base-content text-base-content hover:bg-base-content hover:text-base-100 transition-colors px-4 py-2 rounded-lg">Modifier</a>
            {% endif %}
        </div>
    </div>

    {% if article.featuredImage %}
    <figure class="mb-8 rounded-lg overflow-hidden border border-base-300">
        <img src="{{ vich_uploader_asset(article, 'featuredImageFile') }}"
             alt="{{ article.title }}"
             class="w-full max-h-96 object-cover">
    </figure>
    {% endif %}

    <div class="border border-base-300 rounded-lg bg-base-100 mb-8"
         style="padding: {% if themeConfig and themeConfig.layout.spacing == 'compact' %}1.5rem{% elseif themeConfig and themeConfig.layout.spacing == 'comfortable' %}2rem{% else %}2.5rem{% endif %};">
        <div class="article-content"
             data-controller="inline-chart"
             style="text-align: {{ themeConfig ? themeConfig.layout.contentAlignment : 'left' }};
                    font-family: {{ themeConfig and themeConfig.typography.bodyFont == 'montserrat' ? 'Montserrat' : 'Darker Grotesque' }};
                    font-size: {% if themeConfig and themeConfig.typography.bodySize == 'small' %}0.9rem{% elseif themeConfig and themeConfig.typography.bodySize == 'large' %}1.1rem{% else %}1rem{% endif %};
                    line-height: {% if themeConfig and themeConfig.typography.lineHeight == 'tight' %}1.4{% elseif themeConfig and themeConfig.typography.lineHeight == 'relaxed' %}1.8{% else %}1.6{% endif %};">
            {{ article.description|raw }}
        </div>
    </div>

    <style>
        .article-content h1,
        .article-content h2,
        .article-content h3,
        .article-content h4,
        .article-content h5,
        .article-content h6 {
            font-family: {{ themeConfig and themeConfig.typography.headingFont == 'darker-grotesque' ? 'Darker Grotesque' : 'Montserrat' }};
            color: {{ themeConfig ? themeConfig.colors.primary : 'hsl(0, 0%, 9%)' }};
            {% if themeConfig and themeConfig.typography.headingSize == 'small' %}
            font-size: 0.9em;
            {% elseif themeConfig and themeConfig.typography.headingSize == 'large' %}
            font-size: 1.3em;
            {% endif %}
        }

        .article-content blockquote {
            border-left-color: {{ themeConfig ? themeConfig.colors.accent : 'hsl(0, 0%, 15%)' }};
            border-left-width: 4px;
            padding-left: 1rem;
            font-style: italic;
            opacity: 0.8;
        }

        .article-content a {
            color: {{ themeConfig ? themeConfig.colors.accent : 'hsl(0, 0%, 15%)' }};
            text-decoration: underline;
        }

        .article-content code {
            background-color: {{ themeConfig ? themeConfig.colors.base200 : 'hsl(0, 0%, 98%)' }};
            padding: 0.25rem 0.5rem;
            border-radius: 0.25rem;
        }

        .article-content pre {
            background-color: {{ themeConfig ? themeConfig.colors.base200 : 'hsl(0, 0%, 98%)' }};
            padding: 1rem;
            border-radius: 0.5rem;
            overflow-x: auto;
        }
    </style>
</div>
{% endblock %}
