{% extends 'base.html.twig' %}

{% block title %}{{ 'error.404.title'|trans }}{% endblock %}
{% block meta_description %}{{ 'error.404.meta_description'|trans }}{% endblock %}

{% block body %}
<div class="min-h-screen flex items-center justify-center px-4">
  <div class="max-w-2xl w-full text-center">
    {# Error code #}
    <div class="mb-8">
      <h1 class="text-9xl font-bold text-base-content/20">404</h1>
    </div>

    {# Error message #}
    <div class="space-y-4 mb-8">
      <h2 class="text-3xl font-semibold text-base-content">
        {{ 'error.404.heading'|trans }}
      </h2>
      <p class="text-lg text-base-content/70">
        {{ 'error.404.message'|trans }}
      </p>
    </div>

    {# Actions #}
    <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
      {% if app.user %}
        <a href="{{ path('app_dashboard', {_locale: app.request.locale}) }}" class="btn btn-primary">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
          {{ 'error.404.action.dashboard'|trans }}
        </a>
        <button onclick="history.back()" class="btn btn-ghost">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          {{ 'error.404.action.back'|trans }}
        </button>
      {% else %}
        <a href="{{ path('app_login', {_locale: app.request.locale}) }}" class="btn btn-primary">
          {{ 'error.404.action.login'|trans }}
        </a>
      {% endif %}
    </div>

    {# Additional help text #}
    <div class="mt-12 text-sm text-base-content/60">
      <p>{{ 'error.404.help'|trans }}</p>
    </div>
  </div>
</div>
{% endblock %}
