{% extends 'base.html.twig' %}

{% block title %}Prévisualisation - {{ theme.name }}{% endblock %}

{% block body %}
<div class="p-6">
    <div class="mb-6 flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold">Prévisualisation : {{ theme.name }}</h1>
            <p class="opacity-70">Aperçu du rendu de l'article avec ce thème</p>
        </div>
        <a href="{{ path('app_theme_index') }}" class="btn btn-ghost btn-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            Retour
        </a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-1">
            <div class="card border bg-base-100 sticky top-6">
                <div class="card-body">
                    <h3 class="font-bold mb-4">Configuration du thème</h3>

                    <div class="space-y-4 text-sm">
                        <div>
                            <div class="font-medium mb-2">Layout</div>
                            <div class="space-y-1 opacity-70">
                                <div>Largeur: <span class="font-medium">{{ theme.configuration.layout.articleWidth }}</span></div>
                                <div>Image: <span class="font-medium">{{ theme.configuration.layout.featuredImagePosition }}</span></div>
                                <div>Taille image: <span class="font-medium">{{ theme.configuration.layout.featuredImageSize }}</span></div>
                                <div>Espacement: <span class="font-medium">{{ theme.configuration.layout.spacing }}</span></div>
                            </div>
                        </div>

                        <div class="divider my-2"></div>

                        <div>
                            <div class="font-medium mb-2">Typographie</div>
                            <div class="space-y-1 opacity-70">
                                <div>Titres: <span class="font-medium">{{ theme.configuration.typography.headingFont }}</span></div>
                                <div>Corps: <span class="font-medium">{{ theme.configuration.typography.bodyFont }}</span></div>
                                <div>Taille: <span class="font-medium">{{ theme.configuration.typography.bodySize }}</span></div>
                            </div>
                        </div>

                        <div class="divider my-2"></div>

                        <div>
                            <div class="font-medium mb-2">Graphiques</div>
                            <div class="space-y-1 opacity-70">
                                <div>Type: <span class="font-medium">{{ theme.configuration.charts.defaultType }}</span></div>
                                <div>Palette: <span class="font-medium">{{ theme.configuration.charts.colorScheme }}</span></div>
                                <div>Légende: <span class="font-medium">{{ theme.configuration.charts.legendPosition }}</span></div>
                            </div>
                        </div>

                        <div class="divider my-2"></div>

                        <div>
                            <div class="font-medium mb-2">Palette de couleurs</div>
                            <div class="flex flex-wrap gap-2">
                                {% for color in theme.configuration.colors.chartPalette %}
                                    <div class="w-10 h-10 rounded border" style="background: {{ color }};" title="{{ color }}"></div>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="lg:col-span-2">
            <div
                class="card border bg-base-100"
                data-controller="theme-preview"
                data-theme-preview-config-value="{{ theme.configuration|json_encode }}"
            >
                <div class="card-body">
                    <div class="preview-container" style="
                        max-width: {% if theme.configuration.layout.articleWidth == 'narrow' %}600px{% elseif theme.configuration.layout.articleWidth == 'medium' %}800px{% else %}100%{% endif %};
                        margin: 0 auto;
                    ">
                        <article class="space-y-{% if theme.configuration.layout.spacing == 'compact' %}4{% elseif theme.configuration.layout.spacing == 'comfortable' %}6{% else %}8{% endif %}">
                            {% if theme.configuration.layout.featuredImagePosition == 'top' %}
                                <div class="rounded overflow-hidden bg-base-200" style="
                                    height: {% if theme.configuration.layout.featuredImageSize == 'small' %}200px{% elseif theme.configuration.layout.featuredImageSize == 'medium' %}300px{% elseif theme.configuration.layout.featuredImageSize == 'large' %}400px{% else %}500px{% endif %};
                                ">
                                    <div class="w-full h-full flex items-center justify-center opacity-50">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                        </svg>
                                    </div>
                                </div>
                            {% endif %}

                            <div>
                                <h1 class="text-{% if theme.configuration.typography.headingSize == 'small' %}2xl{% elseif theme.configuration.typography.headingSize == 'medium' %}3xl{% else %}4xl{% endif %} font-bold mb-4"
                                    style="font-family: {{ theme.configuration.typography.headingFont == 'montserrat' ? 'Montserrat' : 'Darker Grotesque' }};">
                                    Exemple d'article avec ce thème
                                </h1>

                                <div class="flex items-center gap-4 text-sm opacity-70">
                                    <span>Par Auteur Exemple</span>
                                    <span>•</span>
                                    <span>{{ "now"|date("d M Y") }}</span>
                                </div>
                            </div>

                            <div class="article-content" style="
                                text-align: {{ theme.configuration.layout.contentAlignment }};
                                font-family: {{ theme.configuration.typography.bodyFont == 'montserrat' ? 'Montserrat' : 'Darker Grotesque' }};
                                font-size: {% if theme.configuration.typography.bodySize == 'small' %}0.9rem{% elseif theme.configuration.typography.bodySize == 'medium' %}1rem{% else %}1.1rem{% endif %};
                                line-height: {% if theme.configuration.typography.lineHeight == 'tight' %}1.4{% elseif theme.configuration.typography.lineHeight == 'normal' %}1.6{% else %}1.8{% endif %};
                            ">
                                <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris.</p>

                                <h2>Section avec graphique</h2>

                                <p>Voici un exemple de graphique avec la palette de couleurs du thème :</p>

                                <div class="my-6">
                                    <canvas id="preview-chart" style="max-height: 300px;"></canvas>
                                </div>

                                <p>Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident.</p>

                                <blockquote>
                                    Ceci est une citation d'exemple pour montrer le style des blockquotes dans ce thème.
                                </blockquote>

                                <p>Sed ut perspiciatis unde omnis iste natus error sit voluptatem accusantium doloremque laudantium.</p>
                            </div>
                        </article>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
