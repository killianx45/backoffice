{% extends 'base.html.twig' %}

{% block title %}{{ 'theme.title.list'|trans }}{% endblock %}

{% block body %}
<div class="p-6 max-w-7xl mx-auto" data-controller="theme-preview-modal">
    <div class="mb-8 flex justify-between items-start">
        <div>
            <h1 class="text-3xl font-bold mb-2">{{ 'theme.heading'|trans }}</h1>
            <p class="opacity-70">{{ 'theme.subtitle.list'|trans }}</p>
        </div>
        <a href="{{ path('app_theme_new') }}" class="btn border border-base-content bg-base-content text-base-100 hover:opacity-90">
            {{ 'theme.button.create_theme'|trans }}
        </a>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success mb-6 border border-success/20 bg-success/10">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>{{ message }}</span>
        </div>
    {% endfor %}

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-6">
        {% for theme in themes %}
            <div class="card border bg-base-100 shadow-sm hover:shadow-md transition-shadow">
                <div class="card-body">
                    <div class="flex items-start justify-between mb-3">
                        <div>
                            <h2 class="card-title text-xl">{{ theme.name }}</h2>
                            {% if theme.isActive %}
                                <div class="badge badge-sm mt-2 bg-base-content text-base-100">{{ 'theme.badge.active'|trans }}</div>
                            {% endif %}
                        </div>
                    </div>

                    <p class="opacity-70 mb-4">{{ theme.description }}</p>

                    <div class="mb-4 p-4 bg-base-200 rounded-lg">
                        <div class="text-xs font-medium opacity-60 mb-2">{{ 'theme.preview.colors'|trans }}</div>
                        <div class="flex gap-2">
                            {% for color in theme.configuration.colors.chartPalette|slice(0, 5) %}
                                <div class="w-8 h-8 rounded" style="background: {{ color }};"></div>
                            {% endfor %}
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-4 mb-4 text-sm">
                        <div>
                            <span class="opacity-60">{{ 'theme.preview.layout'|trans }}</span>
                            <span class="font-medium ml-1">{{ theme.configuration.layout.articleWidth|capitalize }}</span>
                        </div>
                        <div>
                            <span class="opacity-60">{{ 'theme.preview.spacing'|trans }}</span>
                            <span class="font-medium ml-1">{{ theme.configuration.layout.spacing|capitalize }}</span>
                        </div>
                        <div>
                            <span class="opacity-60">{{ 'theme.preview.charts'|trans }}</span>
                            <span class="font-medium ml-1">{{ theme.configuration.charts.colorScheme|capitalize }}</span>
                        </div>
                        <div>
                            <span class="opacity-60">{{ 'theme.preview.style'|trans }}</span>
                            <span class="font-medium ml-1">{{ theme.configuration.components.cardStyle|capitalize }}</span>
                        </div>
                    </div>

                    <div class="card-actions justify-end gap-2">
                        <button type="button"
                                class="btn btn-sm border border-base-300 hover:border-base-content gap-1"
                                data-action="click->theme-preview-modal#open"
                                data-preview-url="{{ path('app_theme_preview', {'id': theme.id}) }}">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                            </svg>
                            {{ 'theme.button.preview'|trans }}
                        </button>
                        <a href="{{ path('app_theme_edit', {'id': theme.id}) }}" class="btn btn-sm border border-base-300 hover:border-base-content">
                            {{ 'button.edit'|trans }}
                        </a>
                        {% if not theme.isActive %}
                            <form method="post" action="{{ path('app_theme_activate', {'id': theme.id}) }}" class="inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('activate' ~ theme.id) }}">
                                <button type="submit" class="btn btn-sm border border-base-content bg-base-content text-base-100 hover:opacity-90">
                                    {{ 'button.activate'|trans }}
                                </button>
                            </form>
                        {% else %}
                            <button class="btn btn-sm btn-disabled">{{ 'theme.badge.current'|trans }}</button>
                        {% endif %}
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>

    <dialog data-theme-preview-modal-target="modal"
            class="modal"
            data-action="click->theme-preview-modal#backdropClick">
        <div class="modal-box w-full max-w-full h-screen max-h-screen p-0 rounded-none">
            <iframe data-theme-preview-modal-target="iframe"
                    class="w-full h-full border-0"
                    src="about:blank"
                    title="{{ 'theme.preview.iframe_title'|trans }}"></iframe>
        </div>
    </dialog>
</div>
{% endblock %}
