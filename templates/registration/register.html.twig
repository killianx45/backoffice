{% extends 'base.html.twig' %}

{% block title %}{{ 'registration.title'|trans }}{% endblock %}

{% block body %}
    <div class="min-h-screen flex items-center justify-center px-6 py-12 bg-base-100">
        <div class="w-full max-w-md border border-base-300 rounded-lg p-8 bg-base-100">
            <div class="mb-8">
                <h2 class="text-2xl font-semibold text-base-content text-center">
                    {{ 'registration.heading'|trans }}
                </h2>
            </div>

            {% for flash_error in app.flashes('verify_email_error') %}
                <div class="border border-base-content/20 bg-base-100 rounded-lg p-4 mb-6 flex items-start gap-3">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-base-content/60 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <span class="text-sm text-base-content/80">{{ flash_error }}</span>
                </div>
            {% endfor %}

            {% if form_errors(registrationForm) %}
                <div class="border border-base-content/20 bg-base-100 rounded-lg p-4 mb-6 flex items-start gap-3">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-base-content/60 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <span class="text-sm text-base-content/80">{{ form_errors(registrationForm) }}</span>
                </div>
            {% endif %}

            {{ form_start(registrationForm, {'attr': {'class': 'w-full'}}) }}
                <div class="mb-6">
                    <label class="block text-sm font-medium text-base-content mb-2">
                        {{ form_label(registrationForm.nom) }}
                    </label>
                    {{ form_widget(registrationForm.nom, {'attr': {'class': 'w-full px-4 py-2 border border-base-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-base-content/20 text-sm bg-base-100', 'placeholder': 'Doe'}}) }}
                    <div class="text-xs text-base-content/60 mt-1">{{ form_errors(registrationForm.nom) }}</div>
                </div>

                <div class="mb-6">
                    <label class="block text-sm font-medium text-base-content mb-2">
                        {{ form_label(registrationForm.prenom) }}
                    </label>
                    {{ form_widget(registrationForm.prenom, {'attr': {'class': 'w-full px-4 py-2 border border-base-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-base-content/20 text-sm bg-base-100', 'placeholder': 'John'}}) }}
                    <div class="text-xs text-base-content/60 mt-1">{{ form_errors(registrationForm.prenom) }}</div>
                </div>

                <div class="mb-6">
                    <label class="block text-sm font-medium text-base-content mb-2">
                        {{ form_label(registrationForm.email) }}
                    </label>
                    {{ form_widget(registrationForm.email, {'attr': {'class': 'w-full px-4 py-2 border border-base-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-base-content/20 text-sm bg-base-100', 'placeholder': 'john.doe@email.com'}}) }}
                    <div class="text-xs text-base-content/60 mt-1">{{ form_errors(registrationForm.email) }}</div>
                </div>

                <div class="mb-6">
                    <label class="block text-sm font-medium text-base-content mb-2">
                        {{ form_label(registrationForm.plainPassword) }}
                    </label>
                    {{ form_widget(registrationForm.plainPassword, {'attr': {'class': 'w-full px-4 py-2 border border-base-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-base-content/20 text-sm bg-base-100'}}) }}
                    <div class="text-xs text-base-content/60 mt-1">{{ form_errors(registrationForm.plainPassword) }}</div>
                </div>

                <div class="mb-6">
                    <label class="flex items-center gap-3 cursor-pointer">
                        {{ form_widget(registrationForm.agreeTerms, {'attr': {'class': 'w-4 h-4 border-2 border-base-300 rounded'}}) }}
                        <span class="text-sm text-base-content">{{ form_label(registrationForm.agreeTerms) }}</span>
                    </label>
                    <div class="text-xs text-base-content/60 mt-1">{{ form_errors(registrationForm.agreeTerms) }}</div>
                </div>

                <button type="submit" class="w-full border border-base-content bg-base-content text-base-100 hover:opacity-90 transition-opacity px-4 py-2 rounded-lg text-sm font-medium mt-2">
                    {{ 'button.submit'|trans }}
                </button>
            {{ form_end(registrationForm) }}

            <div class="relative my-8">
                <div class="absolute inset-0 flex items-center">
                    <div class="w-full border-t border-base-300"></div>
                </div>
                <div class="relative flex justify-center text-xs">
                    <span class="px-2 bg-base-100 text-base-content/60">{{ 'common.or'|trans }}</span>
                </div>
            </div>

            <div class="text-center">
                <p class="text-sm text-base-content/60">
                    {{ 'registration.already_have_account'|trans }}
                    <a href="{{ path('app_login') }}" class="text-base-content underline hover:no-underline">{{ 'button.submit'|trans }}</a>
                </p>
            </div>
        </div>
    </div>
{% endblock %}
