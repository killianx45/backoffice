# Cache static assets for 1 year (versioned by Webpack)
<IfModule mod_expires.c>
    ExpiresActive On

    # JavaScript and CSS with versioning
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/css "access plus 1 year"

    # Images
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"

    # Fonts
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>

# Cache-Control headers
<IfModule mod_headers.c>
    # Cache versioned assets for 1 year
    <FilesMatch "\.(js|css|jpg|jpeg|png|webp|svg|woff|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Preload critical fonts for faster rendering
    <FilesMatch "DarkerGrotesque.*\.woff2$">
        Header set Link "</build/fonts/DarkerGrotesque-VariableFont_wght.cfaaba46.woff2>; rel=preload; as=font; type=font/woff2; crossorigin"
    </FilesMatch>
</IfModule>

# Prevent directory listing
Options -Indexes

# Follow symbolic links
Options +FollowSymLinks

# Enable rewrite engine
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Pass Authorization header to PHP for JWT authentication
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Redirect to front controller if not a real file
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>
